{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipelineguard.dev/schemas/unreal-crash-report-v1.schema.json",
  "title": "PipelineGuard Unreal crash report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "crashId",
    "occurredAtUtc",
    "project",
    "build",
    "platform",
    "errorType",
    "errorMessage",
    "stackTrace"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "crashId": { "type": "string", "format": "uuid" },
    "occurredAtUtc": { "type": "string", "format": "date-time" },
    "project": { "type": "string", "minLength": 1, "maxLength": 100 },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "branch"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "branch": { "type": "string", "minLength": 1, "maxLength": 200 },
        "changelist": { "type": ["integer", "null"] }
      }
    },
    "platform": { "type": "string", "minLength": 1, "maxLength": 50 },
    "errorType": { "type": "string", "minLength": 1, "maxLength": 100 },
    "errorMessage": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "stackTrace": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    },
    "metadata": {
      "type": ["object", "null"],
      "maxProperties": 32,
      "propertyNames": { "minLength": 1, "maxLength": 100 },
      "additionalProperties": { "type": "string", "maxLength": 500 }
    }
  }
}
