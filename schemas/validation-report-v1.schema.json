{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pipelineguard:schema:validation-report:1.0",
  "title": "PipelineGuard validation report v1",
  "description": "Portable contract emitted by an Unreal validation run and consumed by PipelineGuard .NET tools.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "toolVersion",
    "startedUtc",
    "completedUtc",
    "project",
    "engineVersion",
    "profile",
    "scope",
    "summary",
    "findings"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "toolVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "startedUtc": {
      "type": "string",
      "format": "date-time"
    },
    "completedUtc": {
      "type": "string",
      "format": "date-time"
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "engineVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "profile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "findings": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetsScanned",
        "rulesRun",
        "errors",
        "warnings",
        "infos",
        "suppressed",
        "durationMs"
      ],
      "properties": {
        "assetsScanned": {
          "type": "integer",
          "minimum": 0
        },
        "rulesRun": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "infos": {
          "type": "integer",
          "minimum": 0
        },
        "suppressed": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ruleId",
        "severity",
        "assetPath",
        "message",
        "remediation",
        "suppressed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "ruleId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "assetPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "remediation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "suppressed": {
          "type": "boolean"
        },
        "suppressionReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "documentationUri": {
          "type": "string",
          "format": "uri",
          "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://",
          "maxLength": 2048
        },
        "metadata": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "minLength": 1,
            "maxLength": 512
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 512
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "suppressed": {
                "const": true
              }
            },
            "required": [
              "suppressed"
            ]
          },
          "then": {
            "required": [
              "suppressionReason"
            ]
          },
          "else": {
            "not": {
              "required": [
                "suppressionReason"
              ]
            }
          }
        }
      ]
    }
  }
}
