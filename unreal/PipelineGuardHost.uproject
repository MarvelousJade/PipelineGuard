{
  "FileVersion": 3,
  "EngineAssociation": "5.6",
  "Category": "Tools",
  "Description": "Minimal host project used to compile and demonstrate the PipelineGuard editor plugin.",
  "Modules": [
    {
      "Name": "PipelineGuardHost",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    }
  ],
  "Plugins": [
    {
      "Name": "AndroidFileServer",
      "Enabled": false
    },
    {
      "Name": "DataValidation",
      "Enabled": false
    },
    {
      "Name": "EnhancedInput",
      "Enabled": false
    },
    {
      "Name": "PipelineGuard",
      "Enabled": true
    }
  ],
  "AdditionalPluginDirectories": [
    "."
  ]
}
