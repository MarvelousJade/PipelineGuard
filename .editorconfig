root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all

[*.{json,yml,yaml,xml,csproj,props,targets,uplugin,uproject}]
indent_style = space
indent_size = 2

[*.{h,cpp}]
indent_style = tab
indent_size = 4
